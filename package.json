{
	"name": "boilerplate",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@scalar/hono-api-reference": "^0.12.18",
			"better-auth": "^1.7.18",
			"hono": "^4.13.16",
			"zod": "^4.6.7",
			"@hono/zod-openapi": "^1.6.3",
			"drizzle-kit": "1.0.0-rc.5",
			"drizzle-orm": "1.0.0-rc.5"
		},
		"catalogs": {
			"svelte": {
				"typescript": "^6.0.3"
			}
		}
	},
	"type": "module",
	"scripts": {
		"db:generate": "bun run --cwd packages/db generate",
		"db:migrate": "bun run --cwd packages/db migrate",
		"db:studio": "bun run --cwd packages/db studio",
		"api:dev": "bun run --cwd apps/api dev",
		"app:dev": "bun run --cwd apps/app dev",
		"app:build": "bun run --cwd apps/app build",
		"app:start": "bun run --cwd apps/app start",
		"check": "bun run --parallel --filter '@boilerplate/*' --if-present check",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"infra": "docker compose up -d",
		"infra:down": "docker compose down"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.91.0",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.4.4"
}
